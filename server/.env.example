PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER/chatapp
JWT_SECRET=replace-with-a-random-secret
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Relay service addresses from your TURN provider (UDP, TCP, TLS when available).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# For a coturn server with use-auth-secret, set this instead of static credentials.
TURN_SHARED_SECRET=
